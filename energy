def calculate_energy(power, hours, days):
    """
    Calculate monthly energy consumption in kWh.
    """
    energy = (power * hours * days) / 1000
    return energy


def calculate_cost(energy, price_per_kwh):
    """
    Calculate electricity cost.
    """
    cost = energy * price_per_kwh
    return cost


def calculate_daily_energy(power, hours):
    """
    Calculate daily energy consumption in kWh.
    """
    daily_energy = (power * hours) / 1000
    return daily_energy
